# Servidor
HOST=0.0.0.0
PORT=8080
ADMIN_PASSWORD=troque-esta-senha
TIMEZONE_OFFSET_MINUTES=-180
DATABASE_PATH=data/ao_ponto.db
FIREBASE_SERVICE_ACCOUNT=firebase-service-account.json
# Na nuvem, cole o conteúdo completo do JSON nesta variável secreta.
FIREBASE_SERVICE_ACCOUNT_JSON=

# WhatsApp Cloud API - deixe vazio durante desenvolvimento local
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=ao-ponto-webhook
META_APP_SECRET=
META_GRAPH_VERSION=v26.0

# Segurança
# Em produção, mantenha true para exigir assinatura do webhook quando META_APP_SECRET estiver configurado.
VERIFY_META_SIGNATURE=true

# Origens exatas do painel Web, separadas por vírgula. Vazio permite só localhost/127.0.0.1.
CORS_ORIGINS=
